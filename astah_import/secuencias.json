   [
    "msg",
    "NT",
    "NT",
    "INSERT notificaciones (PENDIENTE)",
    "self"
   ],
   [
    "msg",
    "NT",
    "SV",
    "202 {id, estado: PENDIENTE}",
    "ret"
   ],
   [
    "msg",
    "NT",
    "NT",
