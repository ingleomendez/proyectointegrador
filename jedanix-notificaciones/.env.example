# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Base de datos PROPIA de Notificaciones (distinta a jedanix_nucleo) ---
DATABASE_URL=postgresql://jedanix_user:jedanix_pass@localhost:5432/jedanix_notificaciones

# --- Correo (SMTP) ---
# Si SMTP_HOST queda vacío, el servicio funciona en MODO SIMULADO: no envía
# correos reales, imprime cada mensaje en la consola y lo registra como ENVIADA.
# Para enviar correos reales (ejemplo con Gmail y "contraseña de aplicación"):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=tu-correo@gmail.com  SMTP_PASS=la-contraseña-de-aplicación
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="JEDANIX <no-reply@jedanix.local>"

# --- Seguridad entre servicios ---
# Clave compartida con el Núcleo (misma NOTIFICACIONES_API_KEY en el .env del Núcleo).
# Si queda vacía, este servicio acepta peticiones de cualquiera (solo para desarrollo).
NOTIFICACIONES_API_KEY=

# --- Enlaces dentro de los correos ---
FRONTEND_URL=http://localhost:4200

# --- Reintentos (notificaciones en estado FALLIDA) ---
REINTENTOS_INTERVALO_SEGUNDOS=60
REINTENTOS_MAX_INTENTOS=5
